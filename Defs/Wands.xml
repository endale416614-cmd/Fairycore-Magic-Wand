  <ThingDef ParentName="FPW_WandBase">
    <defName>FPW_Wand_SilverSerpent</defName>
    <label>silver serpent wand</label>
    <description>An ebony wand with a silver serpent coiled around its grip, tipped with a white crystal set in a silver star ring. It fires white orbs that pierce armor like a charge rifle shot, leave electrical burns and release an EMP pulse that stuns mechanoids.\n\nTwo fire modes: single shot (long range, high accuracy, slow) and burst (three orbs, shorter range, lower accuracy). Every orb staggers its target. The elemental effects grow with the caster's psychic sensitivity, with diminishing returns (x1 at 100%, x1.5 at 200%, never above x3).\n\nOnly a psycaster can channel it: a pawn without a psylink level or a psycast cannot fire it, and fights with it as a plain wooden stick.</description>
    <graphicData>
      <texPath>FairycorePixieWands/Wands/SilverSerpent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <verbs>
      <li>
          <verbClass>FairycorePixieWands.Verb_ShootWand</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>FPW_Orb_White</defaultProjectile>
          <warmupTime>1.7</warmupTime>
          <range>36.9</range>
          <soundCast>Shot_ChargeBlaster</soundCast>
          <soundCastTail>GunTail_Light</soundCastTail>
          <muzzleFlashScale>0</muzzleFlashScale>
        </li>
    </verbs>
    <modExtensions>
      <li Class="FairycorePixieWands.WandExtension">
        <burstVerb>
          <verbClass>FairycorePixieWands.Verb_ShootWand</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>FPW_Orb_White</defaultProjectile>
          <warmupTime>0.9</warmupTime>
          <range>22.9</range>
          <burstShotCount>3</burstShotCount>
          <ticksBetweenBurstShots>11</ticksBetweenBurstShots>
          <soundCast>Shot_ChargeBlaster</soundCast>
          <soundCastTail>GunTail_Light</soundCastTail>
          <muzzleFlashScale>0</muzzleFlashScale>
        </burstVerb>
        <burstStats>
          <AccuracyTouch>0.85</AccuracyTouch>
          <AccuracyShort>0.65</AccuracyShort>
          <AccuracyMedium>0.35</AccuracyMedium>
          <AccuracyLong>0.20</AccuracyLong>
          <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
        </burstStats>
        <singleIcon>FairycorePixieWands/UI/Single_White</singleIcon>
        <burstIcon>FairycorePixieWands/UI/Burst_White</burstIcon>
        <glowTexPath>FairycorePixieWands/Wands/SilverSerpent_Glow</glowTexPath>
